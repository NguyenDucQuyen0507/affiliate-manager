# Copy to .env and fill in. Never commit .env.

# Local PostgreSQL started with `docker compose up -d db` (see compose.yaml).
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=5432

# Prisma connection string, e.g. postgresql://USER:PASSWORD@localhost:5432/DB?schema=public
DATABASE_URL=

# Password for the admin user created by `npm run db:seed` (admin@example.com).
# At least 12 characters. Only used by the seed script.
SEED_ADMIN_PASSWORD=

# Public site URL, used to show the Bio link address (e.g. https://deals.example.com).
SITE_URL=
